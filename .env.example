# ---------------------------------------------------------------------------
# ResumeTailor AI — environment configuration
# Copy to .env and fill in. NEVER commit the resulting .env file.
# ---------------------------------------------------------------------------

# Anthropic Claude API key. Get one at https://console.anthropic.com/
# If this is omitted the app still runs: it falls back to the deterministic
# offline tailoring engine (lower quality rewriting, identical truthfulness
# guarantees and identical one-page / hyperlink validation).
ANTHROPIC_API_KEY=

# Claude model used for structuring, JD analysis and tailoring.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Where persisted data lives. The default file-backed store needs no setup.
DATABASE_URL=file:./data/db.json

# Backend port.
PORT=4000

# Vite dev server port (read by client/vite.config.ts from this root .env).
CLIENT_PORT=5173

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Absolute or relative directory for uploads and generated PDFs/DOCX.
DATA_DIR=./data

# LaTeX engine used to render the resume. Must be on PATH.
LATEX_ENGINE=pdflatex

# debug | info | warn | error
LOG_LEVEL=info
